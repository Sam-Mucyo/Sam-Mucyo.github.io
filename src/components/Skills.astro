---
import { skillCategories, skillsTitle } from '../data/skills';
---

<section id="skills" class="section skills">
    <div class="container">
        <h2 class="section-title" data-reveal>{skillsTitle}</h2>
        <div class="skills__grid">
            {
                skillCategories.map((category, i) => (
                    <div data-reveal style={`--reveal-delay:${i * 0.1}s`}>
                        <div class="card skills__card">
                            <h3>{category.title}</h3>
                            <ul>
                                {category.skills.map((skill) => (
                                    <li>{skill}</li>
                                ))}
                            </ul>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .skills {
        background: var(--paper);
    }

    .skills__grid {
        display: grid;
        gap: 24px;
    }

    @media (min-width: 600px) {
        .skills__grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 900px) {
        .skills__grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .skills__grid > div {
        height: 100%;
    }

    .skills__card {
        height: 100%;
        padding: 24px;
        transition: transform 0.3s ease-in-out;
    }

    .skills__card:hover {
        transform: translateY(-5px);
    }

    .skills__card h3 {
        margin-bottom: 8px;
        color: var(--primary);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.6;
    }

    .skills__card ul {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .skills__card li {
        padding: 4px 16px;
        border-radius: 8px;
        background: rgba(52, 152, 219, 0.1);
        color: var(--primary);
        font-size: 0.9rem;
    }
</style>
